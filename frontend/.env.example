# Copy this file to .env for local overrides, or set as a real
# environment variable in your deploy platform (e.g. Vercel).

# The backend's public URL. Falls back to http://localhost:4000 if unset,
# which is correct for local dev but MUST be set to the real deployed
# backend URL in production.
VITE_API_BASE_URL="http://localhost:4000"

# Sentry DSN for error tracking. Leave unset to disable Sentry entirely.
# Not a secret — safe to expose in the client bundle.
VITE_SENTRY_DSN=""

# Google Analytics 4 Measurement ID. Not a secret. Left blank locally
# is fine -- gtag.js just no-ops without a real ID.
VITE_GA_MEASUREMENT_ID=""
