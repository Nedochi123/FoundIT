# FoundIT has two parts, each with its own settings file. This file only lists the names: copy the real templates
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env
# Never put real keys, passwords or tokens in any file in this repository.

# ---- backend (Railway "Variables" in production) ----
DATABASE_URL=file:./dev.db
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
ALLOWED_EMAIL_DOMAIN=nileuniversity.edu.ng
ADMIN_EMAILS=
UPLOAD_ROOT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
RESEND_API_KEY=
EMAIL_FROM=FoundIT <onboarding@resend.dev>
SENTRY_DSN=

# ---- frontend (Vercel "Environment Variables" in production) ----
VITE_API_BASE_URL=http://localhost:4000
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=
