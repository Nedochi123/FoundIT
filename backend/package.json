{
  "name": "foundit-backend",
  "version": "1.0.0",
  "description": "FoundIT — campus lost & found backend API",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node db/seed.js",
    "db:reset": "rm -f dev.db dev.db-journal dev.db-wal dev.db-shm && node -e \"require('./db')\" && npm run seed",
    "test": "node --test"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@sentry/node": "^10.75.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "resend": "^6.26.0",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
