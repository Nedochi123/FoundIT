# Copy this file to .env and fill in real values before running.

# SQLite for local dev: "file:./dev.db"
# An absolute path for production, pointing at a Railway persistent volume.
DATABASE_URL="file:./dev.db"

# Generate strong random secrets for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

PORT=4000

# The origin(s) allowed to call this API with credentials (cookies).
# In production this should be your deployed frontend's exact URL.
CLIENT_ORIGIN="http://localhost:5173"

NODE_ENV="development"

# Signup is restricted to this email domain (students, lecturers, and
# HODs alike — no role distinction beyond the domain check).
ALLOWED_EMAIL_DOMAIN="nileuniversity.edu.ng"

# Where uploaded found-item photos are stored. MUST point at a mounted
# persistent volume in production, or every deploy wipes the uploads.
UPLOAD_ROOT=""

# ---------- Web Push (VAPID) — optional, degrades gracefully without it ----------
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@nileuniversity.edu.ng"

# ---------- Email (optional — degrades gracefully without it) ----------
# Get a key from https://resend.com (free tier available). EMAIL_FROM
# must be on a domain you've verified with Resend, or use their shared
# onboarding@resend.dev address for testing only.
RESEND_API_KEY=""
EMAIL_FROM="FoundIT <onboarding@resend.dev>"

# ---------- Error tracking (optional — degrades gracefully without it) ----------
# Get a DSN from https://sentry.io — Settings -> Projects -> [project] -> Client Keys (DSN).
SENTRY_DSN=""
